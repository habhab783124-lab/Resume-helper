# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
dist-ssr/
*.local

# 环境变量文件：可能含真实 API Key、数据库密码，**绝不能提交**
# .env.example 是给人看的模板（只有占位符），要保留在仓库里，所以单独放行
.env
.env.*
!.env.example

# 密钥与证书：宁可多忽略，也别误提交
*.pem
*.key
*.p12
*.jks
*.keystore
id_rsa*
*.ppk

# ZIP packages
*.zip

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# 本机代码索引产物（可再生，不进仓库）
.codegraph/
