# 配置参考：Spring Boot 不会自动读取本文件，请在 shell / 部署平台设置环境变量。
# 不要在本文件写入真实密钥。也可在应用「设置」页面配置个人文本模型。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 默认联网来源无需密钥；可关闭。Tavily 用于可选跨站公开搜索。
TENCENT_JOBS_ENABLED=true
NETEASE_JOBS_ENABLED=true
TAVILY_API_KEY=

# 固定签名密钥可保持重启后登录有效；正式使用时请自行生成随机长字符串。
AUTH_TOKEN_SECRET=
AUTH_ENFORCE=true
SERVER_PORT=8080

# 单机数据目录，启动包原有数据请保留。
AUTH_STORAGE_DIR=./data/auth
MATERIAL_STORAGE_DIR=./data/materials
RESUME_STORAGE_DIR=./data/resumes
INTERVIEW_STORAGE_DIR=./data/interviews
JOB_STORAGE_DIR=./data/jobs
