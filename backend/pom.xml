<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.shijie</groupId>
    <artifactId>resume-helper-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>resume-helper-backend</name>
    <description>拾阶求职工作台 · Java 后端（模块化单体）</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
          文档解析：材料模块（功能一）和面试模块（功能三）都要从上传的简历里抽文本。
          两个库都是纯 Java、无本地依赖。

          - poi-ooxml：读 .docx 的段落与表格。
            旧版 .doc 是二进制格式，需要额外的 poi-scratchpad；我们选择明确提示用户
            「另存为 .docx」，而不是为此多引一个依赖。
          - pdfbox：读文本型 PDF；扫描件（没有文字层）由我们自己检测并给出提示。

          版本以面试模块引入的较新版为准（poi 5.4.1 / pdfbox 3.0.8）。
          合并时两边各声明了一份，重复声明同一依赖会让 Maven 报
          "building the effective model" 警告，已合并成一份。
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          岗位模块（功能二）刻意不引入 MySQL / JPA 依赖：
          岗位检索、匹配、差距分析全部在内存里完成，克隆下来 mvn spring-boot:run 就能跑，
          不因为队友的数据库还没就绪而阻塞联调。

          队友接入用户/资料/简历模块时，再加下面两个依赖，并按 src/main/resources/db/schema.sql
          建表（岗位模块的表结构已经写在里面）：

          <dependency>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-starter-data-jpa</artifactId>
          </dependency>
          <dependency>
              <groupId>com.mysql</groupId>
              <artifactId>mysql-connector-j</artifactId>
              <scope>runtime</scope>
          </dependency>
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              让 `mvn exec:java` 直接跑离线自检（不需要数据库、不需要 API Key）。
              没有这个配置，exec 插件虽然也能靠 Maven 默认插件组解析到，
              但版本和 classpathScope 都不确定，队友容易踩坑。

              用法：
                mvn -q test-compile exec:java
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.shijie.resumehelper.job.JobAgentOfflineDemo</mainClass>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
